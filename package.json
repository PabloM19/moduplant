{
  "name": "moduplant-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8780 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/build-hosted.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 8780 --strictPort",
    "test:hosted": "npm run build && node --test tests/hosted.test.mjs"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "fake-indexeddb": "6.2.8",
    "typescript": "5.9.2",
    "vite": "6.4.2"
  }
}
